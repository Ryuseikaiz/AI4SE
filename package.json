{
  "name": "ai-translator-service",
  "version": "1.0.0",
  "description": "AI file translation service using OpenRouter, LangChain chunking, and Redis parallel processing with Jest unit tests.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test": "jest",
    "test:unit": "jest tests/FileTranslatorService.test.js",
    "test:ai": "set RUN_AI_TESTS=true&& jest tests/ai"
  },
  "keywords": [
    "AI",
    "translation",
    "LangChain",
    "Redis",
    "OpenRouter",
    "Jest"
  ],
  "author": "",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}